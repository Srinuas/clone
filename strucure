    for (let i = 0; i < selected.length; i++) {
        const url = selected[i].dataset.url;
        const name = selected[i].dataset.name;
        await downloadSingleFile({stopPropagation: ()=>{}}, url, name);
        await new Promise(r => setTimeout(r, 500)); 
