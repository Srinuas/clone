@app.post("/api/history")
def handle_history():
    sid, action = request.json.get("session_id"), request.json.get("action")
    if sid not in SESSIONS: return jsonify({"error": "Session expired."}), 404
    session = SESSIONS[sid]
    if action == "undo" and session["current_index"] > 0: session["current_index"] -= 1
    elif action == "redo" and session["current_index"] < len(session["history"]) - 1: session["current_index"] += 1
    else: return jsonify({"error": "Cannot perform history action."}), 400
    return jsonify({"status": "success", "can_undo": session["current_index"] > 0, "can_redo": session["current_index"] < len(session["history"]) - 1})

@app.post("/api/edit")
def apply_edits():
    sid = request.json.get("session_id")
    is_preview = request.json.get("is_preview", False)
    if sid not in SESSIONS: return jsonify({"error": "Session expired."}), 404
    session = SESSIONS[sid]
    try:
        if session["ext"] == "pdf":
            updated_bytes = apply_pdf_edits(session["history"][session["current_index"]], request.json.get("edits", []), request.json.get("mode"))
            doc = fitz.open(stream=updated_bytes, filetype="pdf")
            preview_bytes = doc[0].get_pixmap(dpi=150).tobytes("png")
            doc.close()
        else:
            updated_img = apply_image_edits(cv2.imdecode(np.frombuffer(session["history"][session["current_index"]], dtype=np.uint8), cv2.IMREAD_COLOR), request.json.get("edits", []), request.json.get("mode"))
            updated_bytes = bytes(cv2.imencode(session["orig_ext"] if session["orig_ext"] in ALLOWED_IMAGE_EXTS else ".png", updated_img)[1])
            preview_bytes = bytes(cv2.imencode(".png", updated_img)[1])
        if is_preview:
            return jsonify({"status": "preview", "image": base64.b64encode(preview_bytes).decode('utf-8')})
        else:
            session["history"] = session["history"][:session["current_index"] + 1] + [updated_bytes]
            session["preview_history"] = session["preview_history"][:session["current_index"] + 1] + [preview_bytes]
            session["current_index"] += 1
            return jsonify({"status": "success", "can_undo": True, "can_redo": False})
    except Exception as e:
        app.logger.exception("Edit failed")
        return jsonify({"error": str(e)}), 500

